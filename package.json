{
  "name": "sorteio-grupos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "vite build --config frontend/vite.config.ts && node ace build",
    "build:web": "vite build --config frontend/vite.config.ts",
    "dev": "node ace serve --watch",
    "dev:web": "vite --config frontend/vite.config.ts",
    "sortear": "node ace sortear",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#services/*": "./app/services/*.js",
    "#shared/*": "./app/shared/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/tsconfig": "^1.4.0",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pino-pretty": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-node-maintained": "^10.9.4",
    "typescript": "~5.7.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@adonisjs/core": "^6.17.0",
    "@adonisjs/static": "^1.1.1",
    "reflect-metadata": "^0.2.2"
  }
}
